[mysqld]
# UTC everywhere; business dates are computed in Asia/Kolkata by the application.
default-time-zone = '+00:00'
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY
transaction_isolation = READ-COMMITTED
innodb_lock_wait_timeout = 5
# Migrations create append-only triggers (docs/04 §9); with binary logging on, the migrator user
# needs this to create triggers without SUPER.
log_bin_trust_function_creators = 1
slow_query_log = 1
long_query_time = 0.2
