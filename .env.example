# RingPe backend — every setting the API (server.ts), the worker (worker.ts) and the database CLI read.
# Copy to .env (this folder) for local development. Never commit .env (secrets live in a vault in
# shared environments). Values are validated at start-up; an invalid value stops the process and
# the error names the key, never the value.

# --- Environment -----------------------------------------------------------------------------------
# development | test | production. Production enforces the rules noted below.
NODE_ENV=development
# local | ci | dev | uat | prod (docs/03 §14 environment matrix)
APP_ENV=local
# Shown on the internal /health endpoint.
APP_VERSION=0.1.0-local
GIT_COMMIT=unknown

# --- HTTP ------------------------------------------------------------------------------------------
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# Worker health endpoints (/health/live, /health/ready).
WORKER_HEALTH_PORT=3001
# Express "trust proxy" setting: loopback | a hop count | a comma-separated subnet list.
TRUST_PROXY=loopback
# IPs allowed to read /health (detailed) and /metrics. Default 127.0.0.1,::1.
INTERNAL_ALLOWLIST=127.0.0.1,::1
# Accept X-Correlation-Id from callers (only behind a trusted edge). Default false.
TRUST_INBOUND_CORRELATION_ID=false
# Browser origins allowed by CORS (comma-separated origins, no path; the scheme once). Production: required, https only.
CORS_ORIGINS=https://localhost:4200
# Session cookies are `__Host-` and Secure, which browsers keep only over HTTPS or on localhost.
# Left unset they are Secure everywhere except development, so a plain-HTTP test server opened at
# its LAN address (http://192.168.x.x:4200) keeps its sessions (client 2026-10-06). Production
# refuses false: real schools reach the server over HTTPS only.
# COOKIE_SECURE=
# Serve the OpenAPI document in development only. Production: must be false.
API_DOCS_ENABLED=false
# Maximum JSON request body in bytes (default 1 MB; uploads have their own 2 MB limit, CR-07).
JSON_BODY_LIMIT_BYTES=1048576

# --- HTTPS and the web application (docs/runbooks/https-server.md) ----------------------------------
# A server opened at its address (not localhost) must use HTTPS: browsers keep secure-only features
# (the terminal's device key store for pairing, Secure session cookies) for https:// pages.
# Serve HTTPS from the API itself (as in the reference server.js), TLS 1.2 or newer. Leave false when
# a load balancer or reverse proxy ends TLS in front of the API.
USE_HTTPS=false
# The private key and the certificate chain (certificate + intermediates), PEM files. A LAN or
# internal server: `npm run tls:generate` makes them in keys/tls/ (and a local CA to install on
# devices). A public domain: the files from its certificate authority (e.g. Let's Encrypt).
# KEY_PATH=keys/tls/server.key
# CERTIFICATE_PATH=keys/tls/server.crt
# Only when the private key is encrypted.
# CERT_PASSPHRASE=
# With USE_HTTPS: a plain-HTTP port that only redirects to the HTTPS address (e.g. 80 with HTTP_PORT=443).
# HTTP_REDIRECT_PORT=80
# The built web application (RingPe_Web_App: npm run build). Set, the API serves it on the same
# address, so the console, back office, admissions, portal and terminals use one https:// origin.
# WEB_ROOT=../RingPe_Web_App/dist/browser

# --- Logging (brief §7.2) --------------------------------------------------------------------------
# error | warn | info | http | verbose | debug
LOG_LEVEL=info
# When set, each stream (app, request, response, database, audit, security, job) is also written to
# daily-rotated files in this folder. Leave empty to log to stdout only (containers).
LOG_DIR=
LOG_RETENTION_DAYS=365

# --- MySQL (ADR-0007) ------------------------------------------------------------------------------
# Application user (no DDL). Created by infra/mysql/init/01-users.sql.
DATABASE_URL=mysql://ringpe_app:change-me@127.0.0.1:3306/ringpe
DB_POOL_SIZE=20
# Migrator user (DDL, triggers, grants) — used only by `npm run db:migrate` / db:status / seeds.
DB_MIGRATOR_URL=mysql://ringpe_migrator:change-me@127.0.0.1:3306/ringpe
# Optional override of the migrations folder (defaults to db/migrations in this project, or next to the bundle).
MIGRATIONS_DIR=

# --- Redis (D-08) ----------------------------------------------------------------------------------
# Optional locally (in-memory fallback, one instance only). Production: required. redis:// or rediss://
REDIS_URL=

# --- Authentication (ADR-0011) ---------------------------------------------------------------------
# Token issuer (iss claim).
AUTH_ISSUER=ringpe
# ES256 private signing keys as a JWK set (first key signs; others verify during rotation).
# Local: `npm run keys:generate` writes keys/. Without a file, development uses a temporary key
# (every session ends at restart). Production: required, mounted from the secret store.
AUTH_SIGNING_KEYS_FILE=keys/signing-keys.json
# Separate keys for the back office (audience `ops`, ADR-0011). Production: required.
AUTH_OPS_SIGNING_KEYS_FILE=keys/ops-signing-keys.json

# --- Field encryption (ADR-0012) -------------------------------------------------------------------
# Root keys for PAN, identity-document and bank-account encryption and blind indexes. Never lose
# this file: encrypted data cannot be read without it. Production: required (secret store).
FIELD_KEYS_FILE=keys/field-keys.json

# --- Notifications (Q17: providers to be chosen) ----------------------------------------------------
# log = write messages to the app log instead of sending (development). Production: a provider.
SMS_PROVIDER=log
# Social sign-in (CR-03). test = in-app test provider (client Q17: until the real providers are
# configured); live = Google / Apple (client ids arrive with the provider set-up). Refused in production: test.
SOCIAL_MODE=test
# Bank-account check (₹1 penny drop). test = answers at once in the app (Q17); live = the provider
# once chosen. Refused in production: test.
BANK_VERIFY_MODE=test
# The sponsor bank holding the virtual accounts (example values until the bank is chosen; C-11)
VA_BANK_NAME=Example Bank (example)
# The fee-financing partner (OQ-03; example until the client names it). test = registrations are
# acknowledged at once and decisions come on the signed webhook (FEE-026); live = the partner's API.
# Refused in production: test.
FINANCING_PARTNER_MODE=test
FINANCING_PARTNER_NAME=Example Finance (example)
# Online payment gateway for application and admission fees (Q17: Razorpay). test = an in-app test
# checkout (the order answer carries the test signature); live = Razorpay with the keys below — use
# Razorpay's test keys (rzp_test_…) in development. Refused in production: test, and rzp_test_ keys.
PAYMENT_GATEWAY_MODE=test
# Razorpay (Dashboard → Account & Settings → API keys). The secret stays on the server, never logged.
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
# Dashboard → Webhooks: URL https://<API address>/api/v1/partners/gateway/webhooks, events
# payment.captured and order.paid, and this secret. Required in production.
RAZORPAY_WEBHOOK_SECRET=
# For reference with Razorpay support; not sent to the API.
RAZORPAY_MERCHANT_ID=
# Vouchers to the institution's accounting package (OQ-04; Q14 M15). test = the package is simulated
# (a ledger named TEST-FAIL… is refused, to try the retry path); off = vouchers wait as Pending
# Transfer until the package is chosen. Refused in production: test.
ACCOUNTING_MODE=test
VA_BANK_IFSC=EXMP0000001
# The address people open RingPe at. Every link the API gives out starts with it: the public
# admission link and its QR, fee payment links, gateway webhook addresses, sign-in and password-reset
# e-mails. Write the scheme once (https://192.168.88.16, not https://http://…); refused otherwise.
# - API serving HTTPS and the web app itself (USE_HTTPS + WEB_ROOT): https://<server address>
# - web development server (`npm start` in RingPe_Web_App): https://<this PC's address>:4200
# Must be https:// with USE_HTTPS and in production. Default https://localhost:4200.
PUBLIC_WEB_URL=https://localhost:4200
SOCIAL_PROVIDERS=google,apple
# E-mail (client 2026-10-16). log = written to the app log only (development, tests; refused in
# production). smtp = sent through the mail server below (the earlier application's server by
# default). Port 587 = STARTTLS (EMAIL_SMTP_SECURE=false); 465 = TLS from the start (true).
# EMAIL_USER / EMAIL_PASS: the mailbox's login (the earlier application's names). EMAIL_FROM: the
# sender address (default: EMAIL_USER); the sender's name is the school's, else EMAIL_FROM_NAME.
# EMAIL_TLS_VERIFY=false accepts a mail server certificate that can't be checked: a test server
# only, refused in production. Notices are e-mailed per the school's Notification settings.
EMAIL_PROVIDER=log
EMAIL_SMTP_HOST=mail.sabadotechnologies.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=RingPe
EMAIL_TLS_VERIFY=true
# Phone pushes (client 2026-10-19): notices reach the phone while the app is closed or the phone is
# locked. fcm = Firebase Cloud Messaging; log = the app log only (refused in production); off = none
# (the back office can't switch the push channel on). PUSH_FCM_SERVICE_ACCOUNT_FILE: the Firebase
# project's service-account key (Firebase console → Project settings → Service accounts → Generate
# new private key), e.g. keys/firebase-service-account.json (keys/ is gitignored). Then switch the
# Push channel on in the back office (Messaging channels). Runbook docs/runbooks/push-notifications.md.
PUSH_PROVIDER=off
PUSH_FCM_SERVICE_ACCOUNT_FILE=
# Development only: put one-time codes in the app log so sign-in works without SMS.
# Refused in production.
OTP_DEV_ECHO=false
# Test environments: return one-time codes in the API response; the sign-in screens show them in
# a "test code" banner (client, Q17: providers come later). Left unset it is on in development
# (this machine or a LAN test server) and off otherwise (client 2026-10-06).
OTP_TEST_SHOW_CODE=true
# Production refuses OTP_TEST_SHOW_CODE=true unless this confirms it — for a production-mode test
# server only (client 2026-10-06: "enable now, will change later"). Both must be false before real
# schools use the server: a code shown on screen protects nothing.
OTP_TEST_SHOW_CODE_IN_PRODUCTION=false

# --- Uploads (CR-07: 2 MB, type-checked, virus-scanned, private) ------------------------------------
# local = files under UPLOAD_DIR (development); s3 = object storage (production, Q3).
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
# skip = no antivirus (development only); clamav = scan every upload. Production: clamav.
FILE_SCAN_MODE=skip
# Lifetime of a signed download link.
FILE_URL_TTL_SECONDS=300

# --- Rate limits (NFR-04; 27.4 §5 leaves the values to configuration) ------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
# Requests per network address per window across the API. Generous: a school's Wi-Fi puts hundreds
# of phones behind one address (security review S-05).
RATE_LIMIT_GLOBAL_MAX=3000
# Requests per signed-in session (surface and account) per window.
RATE_LIMIT_SESSION_MAX=300
# Sign-in, OTP and similar routes (applied by those routes from Phase 2).
RATE_LIMIT_AUTH_MAX=20
# IPs exempt from rate limits (comma-separated), e.g. the internal health checker.
RATE_LIMIT_EXEMPT_IPS=

# --- Health and shutdown ---------------------------------------------------------------------------
# Per-dependency timeout for /health/ready.
HEALTH_CHECK_TIMEOUT_MS=2000
# Time allowed to drain requests on SIGTERM before the process is forced to exit.
SHUTDOWN_GRACE_SECONDS=20

# --- Tests (integration suite, real MySQL) ---------------------------------------------------------
# When set, `npm test` also runs tests/integration against this database (it is reset).
TEST_DB_MIGRATOR_URL=

# --- Development sample data (npm run seed:dev; refused in production) ----------------------------
# Passwords given to the sample console staff, back-office operators and the sample parent
# (app sign-in with mobile 9886110000). Empty = the prototype demo passwords.
DEV_STAFF_PASSWORD=
DEV_OPS_PASSWORD=
DEV_MEMBER_PASSWORD=
