{
  "name": "campusone-backend-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CampusOne API (server.ts) and worker (worker.ts): campus wallets, payments and school management, multi-tenant (one code base, ADR-0002).",
  "main": "dist/server.js",
  "author": "SABADO Technologies",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.11 <25",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "devStart": "tsx watch --env-file-if-exists=.env server.ts",
    "devStart:worker": "tsx watch --env-file-if-exists=.env worker.ts",
    "build": "node scripts/build.mjs",
    "migrate": "tsx --env-file-if-exists=.env scripts/db.ts migrate",
    "migrate:status": "tsx --env-file-if-exists=.env scripts/db.ts status",
    "seed": "tsx --env-file-if-exists=.env scripts/db.ts seed-reference",
    "db:triggers": "tsx --env-file-if-exists=.env scripts/export-triggers.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "shared:check": "tsx scripts/shared-copies.ts --check",
    "shared:sync": "tsx scripts/shared-copies.ts --write",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/integration",
    "test:coverage": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --coverage",
    "test:smoke": "node --env-file-if-exists=.env scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "tls:generate": "tsx scripts/generate-tls.ts",
    "seed:dev": "tsx --env-file-if-exists=.env scripts/dev-seed.ts",
    "import:cug-staff": "tsx --env-file-if-exists=.env scripts/import-cug-staff.ts",
    "import:cug-students": "tsx --env-file-if-exists=.env scripts/import-cug-students.ts",
    "import:cug-sheet": "tsx --env-file-if-exists=.env scripts/import-cug-sheet.ts",
    "test:load": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/load",
    "dr:drill": "tsx --env-file-if-exists=.env scripts/dr-drill.ts",
    "e2e:db": "node scripts/e2e-db.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "multer": "2.4.0",
    "mysql2": "3.24.5",
    "nodemailer": "10.0.13",
    "prom-client": "15.1.3",
    "qrcode-generator": "2.0.4",
    "rate-limit-redis": "6.0.1",
    "socket.io": "4.8.4",
    "uuid": "14.0.2",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
